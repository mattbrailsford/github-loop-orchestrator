{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattbrailsford/github-loop-orchestrator/schema/loop-orchestrator.schema.json",
  "title": "loop-orchestrator.yml",
  "description": "Routes GitHub events to a hosted Claude routine. This schema is for editor help; the match script's own checks (src/config.mjs) are the ones that count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "routes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "bots": {
      "description": "Logins to treat as bots, on top of GitHub's own Bot type.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routine_login": {
      "description": "The GitHub login the routine posts as, when it's a person's account. That account's events only count when it addresses the routine with an addressed_with prefix.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "max_hops": {
      "description": "The most edges one chain may follow before the orchestrator stops it.",
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "code_repo": {
      "description": "Where the code lives, when this repo is a separate tracker. Makes this config the hub.",
      "$ref": "#/$defs/repo"
    },
    "claim": {
      "description": "While a run works on an issue or PR, this label is on it and nothing else fires there; comments that come in wait their turn. false turns it off.",
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^[^*]+$",
              "default": "loop/working"
            },
            "stale_after_minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1440,
              "default": 60
            }
          }
        }
      ]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "label": {
      "type": "string",
      "pattern": "^[^*]+\\*?$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "when",
        "prompt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "when": {
          "enum": [
            "issues.opened",
            "issues.labeled",
            "issue_comment.created",
            "pull_request.opened",
            "pull_request.labeled",
            "pr_comment.created",
            "edge",
            "schedule"
          ]
        },
        "if": {
          "$ref": "#/$defs/conditions"
        },
        "prompt": {
          "description": "The prompt template. Placeholders: {repo} {tracker_repo} {code_repo} {code_private} {linked_issue} {number} {kind} {route} {event} {label} {actor} {actor_role} {comment_id} {hop} {next_hop} {request} (mentions or addressed_with routes only) {time}. A schedule route may only use {repo} {tracker_repo} {code_repo} {code_private} {route} {event} {time}.",
          "type": "string",
          "minLength": 1
        },
        "allow_from": {
          "description": "Edge routes only: the routes allowed to start this one.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "code_repo": {
          "$ref": "#/$defs/repo"
        },
        "cron": {
          "description": "Schedule routes only: when it's due, in UTC. Five fields with the minute set to 0, like \"0 7 * * 1-5\".",
          "type": "string",
          "pattern": "^0\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
        },
        "if_claimed": {
          "description": "Label routes only, when claims are on: \"skip\" accepts that a label added while another run holds the claim is skipped, since a label can't wait its turn.",
          "const": "skip"
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "has_label": {
          "$ref": "#/$defs/labels"
        },
        "lacks_label": {
          "$ref": "#/$defs/labels"
        },
        "actor": {
          "enum": [
            "maintainer",
            "author",
            "maintainer_or_author",
            "anyone"
          ]
        },
        "comment_starts_with": {
          "type": "string",
          "minLength": 1
        },
        "mentions": {
          "description": "Logins without @. A mentions route must also have actor: maintainer.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\[bot\\])?$"
          }
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "in": {
          "enum": [
            "tracker",
            "code"
          ]
        },
        "addressed_with": {
          "description": "Prefixes that address the routine, like \"🤖\". The comment's first line must start with one. Must also have actor: maintainer.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        }
      },
      "dependentSchemas": {
        "mentions": {
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "const": "maintainer"
            }
          }
        },
        "addressed_with": {
          "required": [
            "actor"
          ],
          "properties": {
            "actor": {
              "const": "maintainer"
            }
          }
        }
      }
    }
  }
}
